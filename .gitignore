# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data: raw and processed data are never committed (see data/README.md).
# Download scripts reproduce them from the official sources.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated outputs (regenerated by scripts/run_all.sh)
reports/*.json
reports/cache/
*.log
figures/*.png

# OS / editor
.DS_Store
.idea/
.vscode/

# Local credentials (never commit)
.env
